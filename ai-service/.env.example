# 复制为 .env 后修改(已存在的环境变量优先于本文件)
# 两个 .env 的分工:本文件管大脑服务;server/.env 管会话网关;web/.env.local 管前端

# —— LLM 缝口 ——
# 未设置 LLM_BASE_URL 时使用内置 MockPersonaLLM(离线可运行);设置后走 OpenAI 兼容接口
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 生成参数:对话场景建议 0.3(严谨且有对话感);0 为极度严谨
LLM_TEMPERATURE=0.3
# 可选:限制单轮回复最大 token
LLM_MAX_TOKENS=

# —— 托管知识库缝口 ——
# 未设置 KB_BASE_URL 时使用本地关键词检索(data/knowledge/*.md);
# 设置后走远程知识服务,HTTP 契约:POST {query, top_k} → {"chunks":[{"content":...}]}
KB_BASE_URL=
KB_API_KEY=
KB_TOP_K=3

# 服务端口
PORT=8900

# 知识库目录(本地检索用,相对本服务根)
KNOWLEDGE_DIR=data/knowledge
